{
  "name": "afbora/kirby-minify-html",
  "description": "Enable minify HTML output for Kirby",
  "version": "2.4.0",
  "keywords": [
    "kirby3",
    "kirby4",
    "kirby5",
    "kirby6"
  ],
  "type": "kirby-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Ahmet Bora",
      "email": "ahmet@getkirby.com"
    }
  ],
  "homepage": "https://github.com/afbora/kirby-minify-html",
  "support": {
    "email": "ahmet@getkirby.com"
  },
  "require": {
    "php": "^8.2",
    "getkirby/composer-installer": "^1.2",
    "voku/html-min": "^5.0"
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "getkirby/composer-installer": true
    },
    "platform": {
      "php": "8.2.0"
    }
  },
  "extra": {
    "kirby": {
      "compatible": "^3.9 || ^4.0 || ^5.0 || ^6.0"
    }
  },
  "prefer-stable": true
}
